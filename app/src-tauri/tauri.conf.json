{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IAP",
  "version": "0.1.0",
  "identifier": "at.iap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "IAP",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 620,
        "visible": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/iap-logo.png"
    ]
  }
}
